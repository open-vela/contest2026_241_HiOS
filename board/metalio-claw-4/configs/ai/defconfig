#
# Metalio Claw4 AI / OpenClaw application configuration
#
CONFIG_ARCH="risc-v"
CONFIG_ARCH_BOARD="metalio-claw-4"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_METALIO_CLAW_4=y
CONFIG_ARCH_CHIP="esp32p4"
CONFIG_ARCH_CHIP_ESP32P4=y

# ESP32-P4 HP core is RV32IMAFDC — enable single-precision FPU so the
# build uses -march=rv32imafc -mabi=ilp32f, matching the ABI of Espressif's
# prebuilt audio codec / HLS libraries.  DPFPU is left OFF because those
# libraries only use the F (single-precision) extension.
CONFIG_ARCH_HAVE_FPU=y
CONFIG_ARCH_FPU=y

CONFIG_ARCH_INTERRUPTSTACK=4096
CONFIG_ARCH_IRQ_TO_NDX=y
CONFIG_ARCH_MINIMAL_VECTORTABLE_DYNAMIC=y
CONFIG_ARCH_NUSER_INTERRUPTS=17
CONFIG_ARCH_RISCV=y
CONFIG_BOARDCTL=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_LOOPSPERMSEC=15000
CONFIG_BUILTIN=y
CONFIG_ALLOW_GPL_COMPONENTS=y

# TLS — mbedTLS 3.4.0 (software crypto) for wss/https/mqtt-tls/ota.
# Entropy: ESP32-P4 hardware TRNG (/dev/random, CONFIG_DEV_RANDOM defaults y
# via ARCH_HAVE_RNG). MBEDTLS_ENTROPY_HARDWARE_ALT makes mbedtls read
# /dev/random through entropy_alt.c instead of the getrandom(/dev/urandom) path.
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_MBEDTLS_ENTROPY_HARDWARE_ALT=y
CONFIG_CXX_STANDARD="gnu++17"
# CONFIG_CXX_EXCEPTION is not set
# CONFIG_CXX_RTTI is not set
# CONFIG_LIBCXXNONE is not set
# CONFIG_LIBCXXTOOLCHAIN is not set
# CONFIG_LIBCXX is not set
CONFIG_UCLIBCXX=y
CONFIG_UCLIBCXX_BUFSIZE=32
CONFIG_LIBMINIABI=y
CONFIG_LIBM=y
CONFIG_ESPRESSIF_CHIP_SERIES="esp32p4"
CONFIG_ESPRESSIF_FLASH_32M=y
CONFIG_ESPRESSIF_I2C0=y
CONFIG_ESPRESSIF_I2C0_SDAPIN=7
CONFIG_ESPRESSIF_I2C0_SCLPIN=8
CONFIG_ESPRESSIF_SPIRAM=y
CONFIG_ESPRESSIF_SPIRAM_BOOT_INIT=y
CONFIG_ESPRESSIF_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESPRESSIF_SPIRAM_USER_HEAP=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_EXPERIMENTAL=y
CONFIG_FS_PROCFS=y
CONFIG_GRAPHICS_LVGL=y
# Dark default theme — MetalioClaw4 UI is dark; the light default theme
# paints unstyled widgets blue/white ("blue screen").
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_I2C=y
CONFIG_IDLETHREAD_STACKSIZE=16384
CONFIG_INIT_ENTRYPOINT="metalio_main"
CONFIG_LCD=y
CONFIG_LCD_FRAMEBUFFER=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_LCD=y
CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y
CONFIG_METALIO_APP=y
CONFIG_METALIO_BATCH8=y
CONFIG_METALIO_CAMERA_OV2710=y
CONFIG_METALIO_DISPLAY_NV3051F=y
CONFIG_METALIO_ESP_HOSTED=y
CONFIG_METALIO_WIFI_SSID=""
CONFIG_METALIO_WIFI_PASSWORD=""
CONFIG_ESPRESSIF_MIPI_CSI=y
CONFIG_ESPRESSIF_MIPI_CSI_LANES=1
CONFIG_ESPRESSIF_MIPI_CSI_LANE_BITRATE_MBPS=800
CONFIG_ESPRESSIF_MIPI_DSI=y
CONFIG_ESPRESSIF_MIPI_DSI_BUS=0
CONFIG_ESPRESSIF_MIPI_DSI_LANES=2
CONFIG_ESPRESSIF_MIPI_DSI_LANE_BITRATE_MBPS=1000
CONFIG_METALIO_TOUCH_GT911=y
CONFIG_METALIO_ESP_GMF=y
CONFIG_METALIO_ESP_SR=y
CONFIG_METALIO_USE_AFE_WAKE_WORD=y
CONFIG_METALIO_USE_AUDIO_PROCESSOR=y
CONFIG_METALIO_GMF_FFT=y
CONFIG_METALIO_GMF_CORE=y
CONFIG_METALIO_GMF_IO=y
CONFIG_METALIO_GMF_HLS=y
CONFIG_METALIO_GMF_CODEC=y

# LCD backlight PWM — LEDC timer0 on GPIO 52, 10-bit resolution.
# board_ledc_setup() registers /dev/pwm0; the app's PwmBacklight drives it
# at 25 kHz (matching MetalioClaw4 main/boards/common/backlight.cc).
CONFIG_ESPRESSIF_LEDC=y
CONFIG_ESPRESSIF_LEDC_HPOINT=0x0000
CONFIG_ESPRESSIF_LEDC_TIMER0=y
CONFIG_ESPRESSIF_LEDC_TIMER0_RESOLUTION=10
CONFIG_ESPRESSIF_LEDC_CHANNEL0_PIN=52
# Vibration motor PWM — LEDC timer1 on GPIO 22, 10-bit resolution.
# board_ledc_setup() registers /dev/pwm1 for the vibrate test.
CONFIG_ESPRESSIF_LEDC_TIMER1=y
CONFIG_ESPRESSIF_LEDC_TIMER1_CHANNELS=1
CONFIG_ESPRESSIF_LEDC_TIMER1_RESOLUTION=10
CONFIG_ESPRESSIF_LEDC_CHANNEL1_PIN=22

CONFIG_MM_REGIONS=3
CONFIG_NET=y
CONFIG_NET_BROADCAST=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_TLS_NELEM=4
CONFIG_SCHED_EVENTS=y
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_ONESHOT=y
CONFIG_ONESHOT_COUNT=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_BACKTRACE=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_WAITPID=y
CONFIG_START_DAY=29
CONFIG_START_MONTH=11
CONFIG_START_YEAR=2019
CONFIG_SYSTEM_NSH=y
CONFIG_ESPRESSIF_USBSERIAL=y
# CONFIG_UART0_SERIAL_CONSOLE is not set
CONFIG_ESPRESSIF_UART0=y
CONFIG_ESPRESSIF_UART0_TXPIN=38
CONFIG_ESPRESSIF_UART0_RXPIN=37
CONFIG_UART0_BAUD=9600
CONFIG_ESPRESSIF_UART2=y
CONFIG_ESPRESSIF_UART2_TXPIN=26
CONFIG_ESPRESSIF_UART2_RXPIN=27
CONFIG_UART2_BAUD=115200
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKPRIORITY=224
CONFIG_SCHED_HPWORKSTACKSIZE=2048
CONFIG_DRIVERS_VIDEO=y
CONFIG_VIDEO_FB=y
CONFIG_VIDEO_STREAM=y
CONFIG_WIRELESS=y

# Audio subsystem — direct I2S (no I2C codec on this board).
# ESP32-P4 I2S0: BCLK=12 WS=10 DOUT=9 DIN=11, 16-bit 16kHz master mode.
# board_i2s_init() registers /dev/audio/pcm0 (TX) + /dev/audio/pcm_in0 (RX).
CONFIG_AUDIO=y
CONFIG_DRIVERS_AUDIO=y
CONFIG_AUDIO_I2S=y
CONFIG_ESPRESSIF_I2S=y
CONFIG_ESPRESSIF_I2S0=y
CONFIG_ESPRESSIF_I2S0_TX=y
CONFIG_ESPRESSIF_I2S0_RX=y
CONFIG_ESPRESSIF_I2S0_ROLE_SLAVE=y
CONFIG_ESPRESSIF_I2S0_DATA_BIT_WIDTH_32BIT=y
CONFIG_ESPRESSIF_I2S0_SAMPLE_RATE=16000
CONFIG_ESPRESSIF_I2S0_BCLKPIN=12
CONFIG_ESPRESSIF_I2S0_WSPIN=10
CONFIG_ESPRESSIF_I2S0_DOUTPIN=9
CONFIG_ESPRESSIF_I2S0_DINPIN=11
# Match Claw4 AUDIO_CODEC_DMA_DESC_NUM=6 — default 2 is too shallow for TTS.
CONFIG_I2S_DMADESC_NUM=6
CONFIG_ESP32P4_SDMMC=y
CONFIG_MMCSD=y
CONFIG_MMCSD_SDIO=y
CONFIG_SDIO_BLOCKSETUP=y
CONFIG_SDIO_MUXBUS=y
# CONFIG_SDIO_WIDTH_D1_ONLY is not set
# No mechanical CD pin on Claw4 Slot0 — always-PRESENT + HAVE_CARDDETECT
# leaves a failed first probe waiting forever for an eject event.
# CONFIG_MMCSD_HAVE_CARDDETECT is not set
CONFIG_MMCSD_BLOCK_WDATADELAY=2000
CONFIG_MMCSD_CHECK_READY_STATUS_WITHOUT_SLEEP=y
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FAT_MAXFNAME=64
CONFIG_LV_FONT_FMT_TXT_LARGE=y
