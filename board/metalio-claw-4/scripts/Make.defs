include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/tools/espressif/Config.mk
include $(TOPDIR)/arch/risc-v/src/common/Toolchain.defs

# Remove quotes from CONFIG_ESPRESSIF_CHIP_SERIES configuration

CHIP_SERIES = $(patsubst "%",%,$(CONFIG_ESPRESSIF_CHIP_SERIES))

# Pick the linker scripts from the board level if they exist, if not
# pick the common linker scripts.

ARCHSCRIPT += $(BOARD_COMMON_DIR)/scripts/$(CHIP_SERIES)_aliases.ld

ARCHSCRIPT += $(call FINDSCRIPT,$(CHIP_SERIES)_flat_memory.ld)

ifneq ($(CONFIG_ESP32P4_SELECTS_REV_LESS_V3),y)
  BOARD_REV = .rev3
endif

ifeq ($(CONFIG_ESPRESSIF_BOOTLOADER_MCUBOOT),y)
  ARCHSCRIPT += $(call FINDSCRIPT,$(CHIP_SERIES)_sections$(BOARD_REV).ld)
else ifeq ($(CONFIG_ESPRESSIF_SIMPLE_BOOT),y)
  ARCHSCRIPT += $(call FINDSCRIPT,$(CHIP_SERIES)_sections$(BOARD_REV).ld)
endif


# GCC 14 (riscv32-esp-elf) treats implicit decls as errors; Apache ESP32-P4
# HAL/adapters still need a few openvela API shims while the port hardens.
CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -Werror=return-type -Wno-error=implicit-function-declaration -Wno-implicit-function-declaration
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -Wno-error=implicit-function-declaration -Wno-implicit-function-declaration
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

# Loadable module definitions

LDMODULEFLAGS += -melf32lriscv

# ELF module definitions

LDELFFLAGS += -melf32lriscv

# When using the toolchain C++ STL (LIBCXXTOOLCHAIN), NuttX only auto-links
# libsupc++.a (runtime). The STL containers (std::string/vector/map) live in
# libstdc++.a, so link it explicitly for the Metalio app port.
ifeq ($(CONFIG_LIBCXXTOOLCHAIN),y)
  EXTRA_LIBS += $(wildcard $(shell $(CC) $(ARCHCPUFLAGS) --print-file-name=libstdc++.a))
endif

# Fail closed if WakeNet opens unmounted SPIFFS model paths.
EXTRALINKCMDS += --wrap=fopen
# Prebuilt jumps to ROM memset by absolute address — must wrap.
EXTRALINKCMDS += --wrap=dl_nn_bzero
EXTRALINKCMDS += --wrap=bzero
# P4 SR memcpy hard-locks on SPIRAM destinations (sigmoid_table fallback).
EXTRALINKCMDS += --wrap=dl_nn_memcpy
# ROM mem* hang on SPIRAM; memset is SPIRAM-aware (see metalio_psram_memcpy.ld).
EXTRALINKCMDS += -T$(TOPDIR)/boards/risc-v/esp32p4/metalio-claw-4/scripts/metalio_psram_memcpy.ld
