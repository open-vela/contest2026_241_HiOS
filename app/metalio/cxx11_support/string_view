/*
 * apps/metalio/cxx11_support/string_view — minimal C++17 std::string_view
 *
 * Metalio only needs: construct from (const char*, size_t) or
 * (const char*) [implicit NUL length], size(), length(), data(),
 * operator[], substr(), begin()/end(), comparison operators, and
 * find(char)/find(string_view)/rfind.  We do NOT attempt the full
 * Standard API.
 */
#ifndef METALIO_CXX17_STRING_VIEW_SHIM_H_
#define METALIO_CXX17_STRING_VIEW_SHIM_H_

#ifndef CONFIG_UCLIBCXX_BUFSIZE
#  define CONFIG_UCLIBCXX_BUFSIZE 32
#endif

#include <cstddef>
#include <cstring>
#include <string>   /* uClibc++ native std::string for conversions */

#if __has_include_next(<string_view>)
#  include_next <string_view>
#endif

namespace std {

class string_view
{
public:
  typedef size_t    size_type;
  typedef char      value_type;
  typedef const char* pointer;
  typedef const char* const_pointer;
  typedef const char& reference;
  typedef const char& const_reference;
  typedef const char* const_iterator;
  typedef const_iterator iterator;

  /* Constructors */
  constexpr string_view() noexcept : data_(0), size_(0) {}
  string_view(const char *s)           : data_(s), size_(s ? strlen(s) : 0) {}
  constexpr string_view(const char *s, size_type n)
    : data_(s), size_(n) {}
  /* string_view from std::string is intentionally not marked explicit so
   * callers can pass std::string to string_view params transparently. */
  string_view(const std::string &s) : data_(s.data()), size_(s.size()) {}

  /* Iterators */
  constexpr const_iterator begin()  const noexcept { return data_; }
  constexpr const_iterator end()    const noexcept { return data_ + size_; }
  constexpr const_iterator cbegin() const noexcept { return data_; }
  constexpr const_iterator cend()   const noexcept { return data_ + size_; }

  /* Element access */
  constexpr const_reference operator[](size_type n) const { return data_[n]; }
  constexpr pointer data()  const noexcept { return data_; }

  /* Capacity */
  constexpr size_type size()     const noexcept { return size_; }
  constexpr size_type length()   const noexcept { return size_; }
  constexpr bool      empty()    const noexcept { return size_ == 0; }
  static constexpr size_type npos = static_cast<size_type>(-1);

  /* Modifiers */
  void remove_prefix(size_type n)
  { if (n > size_) n = size_; data_ += n; size_ -= n; }

  void remove_suffix(size_type n)
  { if (n > size_) size_ = 0; else size_ -= n; }

  /* Substring (return value adjusted to heap string because metalio
   * only ever assigns substr() to a std::string anyway.) */
  std::string substr(size_type pos = 0, size_type n = npos) const
  {
    if (pos > size_) pos = size_;
    if (n == npos || pos + n > size_) n = size_ - pos;
    return std::string(data_ + pos, n);
  }

  /* Search helpers */
  size_type find(char c, size_type pos = 0) const noexcept
  {
    for (size_type i = pos; i < size_; ++i)
      if (data_[i] == c) return i;
    return npos;
  }

  size_type find(string_view v, size_type pos = 0) const noexcept
  {
    if (v.size_ == 0) return pos;
    if (v.size_ > size_) return npos;
    for (size_type i = pos; i + v.size_ <= size_; ++i) {
      size_type j;
      for (j = 0; j < v.size_; ++j)
        if (data_[i + j] != v.data_[j]) break;
      if (j == v.size_) return i;
    }
    return npos;
  }

  size_type rfind(char c, size_type pos = npos) const noexcept
  {
    if (size_ == 0) return npos;
    if (pos >= size_) pos = size_ - 1;
    for (size_type i = pos + 1; i-- > 0; )
      if (data_[i] == c) return i;
    return npos;
  }

private:
  const char *data_;
  size_type   size_;
};

/* ---- comparison operators ---- */
inline bool operator==(string_view a, string_view b) noexcept
{
  return a.size() == b.size() &&
         (a.size() == 0 || memcmp(a.data(), b.data(), a.size()) == 0);
}
inline bool operator!=(string_view a, string_view b) noexcept { return !(a == b); }
inline bool operator< (string_view a, string_view b) noexcept
{
  size_t n = a.size() < b.size() ? a.size() : b.size();
  int r = (n == 0) ? 0 : memcmp(a.data(), b.data(), n);
  return r < 0 || (r == 0 && a.size() < b.size());
}
inline bool operator<=(string_view a, string_view b) noexcept { return !(b < a); }
inline bool operator> (string_view a, string_view b) noexcept { return   b < a;  }
inline bool operator>=(string_view a, string_view b) noexcept { return !(a < b); }

} /* namespace std */

#endif /* METALIO_CXX17_STRING_VIEW_SHIM_H_ */
