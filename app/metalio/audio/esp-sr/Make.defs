############################################################################
# apps/metalio/audio/esp-sr/Make.defs
#
# ESP-SR 2.2.2 + dl_fft + esp-dsp wiring for Metalio on NuttX/ESP32-P4.
# Included by apps/metalio/Makefile when CONFIG_METALIO_ESP_SR=y.
############################################################################

ifeq ($(CONFIG_METALIO_ESP_SR),y)

ESP_SR_ROOT   = audio/esp-sr
DL_FFT_ROOT   = $(ESP_SR_ROOT)/dl_fft/component
ESP_DSP_ROOT  = $(ESP_SR_ROOT)/esp-dsp/component
SR_SHIMS      = audio/esp-gmf/nuttx_shims

# Headers: chip-specific AFE + model_path + freertos redirects + our port
CFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)/include/esp32p4
CFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)/src/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)
CFLAGS += -I$(APPDIR)/metalio/$(DL_FFT_ROOT)
CFLAGS += -I$(APPDIR)/metalio/$(DL_FFT_ROOT)/base
CFLAGS += -I$(APPDIR)/metalio/$(DL_FFT_ROOT)/base/isa
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/fft/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/math/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/math/sqrt/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/common/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/dotprod/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/support/include
CFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/matrix/mul/include
CFLAGS += -I$(APPDIR)/metalio/$(SR_SHIMS)
CFLAGS += -I$(APPDIR)/metalio/port
# Provide esp_attr.h / sdkconfig.h for dl_fft assembly & C
CFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)
CFLAGS += -I$(APPDIR)/metalio/audio/wake_words
CFLAGS += -I$(APPDIR)/metalio/audio/processors
# model_path.c uses ESP_LOGI without always including esp_log.h
CFLAGS += -include $(APPDIR)/metalio/port/esp_log_shim.h
# Assembler finds model/srmodels.bin next to srmodels_bin.S
AFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)

CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)/include/esp32p4
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)/src/include
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_SR_ROOT)
CXXFLAGS += -I$(APPDIR)/metalio/$(DL_FFT_ROOT)
CXXFLAGS += -I$(APPDIR)/metalio/$(DL_FFT_ROOT)/base
CXXFLAGS += -I$(APPDIR)/metalio/$(DL_FFT_ROOT)/base/isa
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/fft/include
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/math/include
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/math/sqrt/include
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/common/include
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/dotprod/include
CXXFLAGS += -I$(APPDIR)/metalio/$(ESP_DSP_ROOT)/modules/support/include
CXXFLAGS += -I$(APPDIR)/metalio/$(SR_SHIMS)
CXXFLAGS += -I$(APPDIR)/metalio/port
CXXFLAGS += -I$(APPDIR)/metalio/audio/wake_words
CXXFLAGS += -I$(APPDIR)/metalio/audio/processors
CXXFLAGS += -include $(APPDIR)/metalio/port/esp_log_shim.h

CFLAGS += -DMETALIO_HAS_ESP_SR=1
CXXFLAGS += -DMETALIO_HAS_ESP_SR=1
# Use ANSI FFT kernels — NuttX Application.mk cannot build nested .S paths.
CFLAGS += -DCONFIG_IDF_TARGET_ESP32P4=1
CFLAGS += -DCONFIG_DSP_MAX_FFT_SIZE=4096
# Force ansi (no arp4 .S) even on P4
CFLAGS += -UCONFIG_DSP_OPTIMIZED
CXXFLAGS += -DCONFIG_IDF_TARGET_ESP32P4=1
CXXFLAGS += -DCONFIG_DSP_MAX_FFT_SIZE=4096
CXXFLAGS += -UCONFIG_DSP_OPTIMIZED

# --- Sources: model_path + debug + dl_fft ANSI + esp-dsp ANSI ---
# Use NuttX-patched model_path so srmodel_load is not gated on ESP_PLATFORM.
CSRCS += $(ESP_SR_ROOT)/model_path_nuttx.c
CSRCS += $(ESP_SR_ROOT)/src/esp_sr_debug.c
CSRCS += $(ESP_SR_ROOT)/metalio_srmodel_boot.c
CSRCS += $(ESP_SR_ROOT)/srmodels_bin.c
CSRCS += port/esp_sr_link_exports.c

CSRCS += $(DL_FFT_ROOT)/dl_fft_f32.c
CSRCS += $(DL_FFT_ROOT)/dl_fft_s16.c
CSRCS += $(DL_FFT_ROOT)/dl_rfft_f32.c
CSRCS += $(DL_FFT_ROOT)/dl_rfft_s16.c
CSRCS += $(DL_FFT_ROOT)/base/dl_fft2r_fc32_ansi.c
CSRCS += $(DL_FFT_ROOT)/base/dl_fft4r_fc32_ansi.c
CSRCS += $(DL_FFT_ROOT)/base/dl_fft2r_sc16_ansi.c
CSRCS += $(DL_FFT_ROOT)/base/dl_fft2r_sc16_dif_ansi.c
CSRCS += $(DL_FFT_ROOT)/base/dl_fft_base.c

CSRCS += $(ESP_DSP_ROOT)/modules/fft/float/dsps_fft2r_fc32_ansi.c
CSRCS += $(ESP_DSP_ROOT)/modules/fft/float/dsps_fft2r_bitrev_tables_fc32.c
CSRCS += $(ESP_DSP_ROOT)/modules/dotprod/float/dsps_dotprod_f32_ansi.c
# dsps_sqrt / power_of_two / arp4 aliases provided in esp_sr_link_exports.c

VPATH += :$(ESP_SR_ROOT) :$(ESP_SR_ROOT)/src
VPATH += :$(DL_FFT_ROOT) :$(DL_FFT_ROOT)/base
VPATH += :$(ESP_DSP_ROOT)/modules/fft/float
VPATH += :$(ESP_DSP_ROOT)/modules/dotprod/float

# --- Prebuilt esp-sr archives (ESP32-P4) ---
# Final nuttx link only auto-picks apps/staging/*.a (see arch/.../Makefile).
# Symlink required archives there; arch already wraps LDLIBS in --start-group.
ESP_SR_LIBDIR = $(APPDIR)/metalio/$(ESP_SR_ROOT)/lib/esp32p4
ESP_SR_STAGED = libesp_audio_front_end.a libesp_audio_processor.a \
	libwakenet.a libnsnet.a libvadnet.a libdl_lib.a \
	libc_speech_features.a libhufzip.a
# Keep -l forms for module builds; staging covers the kernel nuttx link.
# Ensure apps/staging has symlinks (arch link only pulls staging/*.a).
ESP_SR_STAGE_DIR = $(APPDIR)/staging
$(shell mkdir -p $(ESP_SR_STAGE_DIR); \
  for f in $(ESP_SR_STAGED); do \
    ln -sfn ../metalio/$(ESP_SR_ROOT)/lib/esp32p4/$$f $(ESP_SR_STAGE_DIR)/$$f; \
  done)

EXTRA_LIBPATHS += -L$(ESP_SR_LIBDIR)
EXTRA_LIBS += -lesp_audio_front_end -lesp_audio_processor
EXTRA_LIBS += -lwakenet -lnsnet -lvadnet
EXTRA_LIBS += -ldl_lib -lc_speech_features -lhufzip

ifeq ($(CONFIG_METALIO_USE_AFE_WAKE_WORD),y)
CXXSRCS += audio/wake_words/afe_wake_word.cxx
CXXSRCS += audio/wake_words/esp_wake_word.cxx
endif

ifeq ($(CONFIG_METALIO_USE_AUDIO_PROCESSOR),y)
CXXSRCS += audio/processors/afe_audio_processor.cxx
endif

endif # CONFIG_METALIO_ESP_SR
